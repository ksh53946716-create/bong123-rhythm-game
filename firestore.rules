rules_version = '2';
// Bong's Game — 서버 보안 규칙 (브라우저에서 우회 불가: Firebase 서버가 직접 검사)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validKey(k) { return k is string && k.matches('^[a-z0-9가-힣_]{2,16}$'); }
    // 개발자 계정 (게임 아이디 KSH): 「개발자」 칭호와 예약된 닉네임은 이 계정만 쓸 수 있음
    function isDev() { return request.auth.uid in ['9R3rJTrsOyS1crzNgMlcBxHhAZx1']; }

    // 아이디 선점표: 한 번 만들면 바꾸거나 지울 수 없음 → 아이디 중복 불가
    match /names/{key} {
      allow read: if true;
      allow create: if signedIn() && validKey(key)
        && request.resource.data.keys().hasOnly(['uid', 'key'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.key == key
        && !exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
      allow update, delete: if false;
    }
    // 계정 정보: 본인만, 처음 한 번만 만들 수 있고 아이디는 위 선점표와 일치해야 함
    match /accounts/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gameId', 'key', 'provider', 'at'])
        && validKey(request.resource.data.key) && request.resource.data.gameId.lower() == request.resource.data.key
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.key)).data.uid == uid;
      allow update, delete: if false;
    }
    // 랭킹 기록: 누구나 읽고, 본인 기록만 쓰기 (닉네임은 자기 계정 아이디로 고정)
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/accounts/$(uid))
        && request.resource.data.keys().hasOnly(['nick', 'best', 'total', 'v', 'ss', 'dc', 'wc', 'md', 'sv'])
        && request.resource.data.get('md', {}) is map && request.resource.data.get('md', {}).size() <= 10
        && request.resource.data.get('ss', {}) is map && request.resource.data.get('ss', {}).size() <= 4
        && request.resource.data.nick == get(/databases/$(database)/documents/accounts/$(uid)).data.gameId
        && request.resource.data.best is map && request.resource.data.best.size() <= 400
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 400000000;
      allow delete: if false;
    }
    // 프로필: 닉네임(2~12자) + 사진(작은 JPEG/PNG/WebP, 약 110KB 이하) + 칭호 · 꾸미기 · 업적용 누적 기록. 본인만 쓰기, 누구나 읽기
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/accounts/$(uid))
        && request.resource.data.keys().hasOnly(['nick', 'photo', 'at', 'title', 'eq', 'st', 'fr', 'rw'])
        && request.resource.data.get('rw', []) is list && request.resource.data.get('rw', []).size() <= 40
        && request.resource.data.get('fr', []) is list && request.resource.data.get('fr', []).size() <= 100
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 16
        && (request.resource.data.get('title', '') != '개발자' || isDev())
        && (request.resource.data.get('title', '') != '최초의 사신' || get(/databases/$(database)/documents/firsts/death).data.uid == request.auth.uid)
        && (!(request.resource.data.nick in ['개발자', '운영자', '관리자']) || isDev())
        && request.resource.data.get('eq', {}) is map && request.resource.data.get('eq', {}).keys().hasOnly(['g', 'n'])
        && request.resource.data.get('st', {}) is map && request.resource.data.get('st', {}).size() <= 32
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 12
        && request.resource.data.nick.matches('^[-A-Za-z0-9가-힣_. ]+$')
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 150000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // 친구 대결: 보낸 사람·받은 사람만 볼 수 있음. 보낸 점수는 내 랭킹 기록과 같아야 하고, 받은 사람은 한 번만 응답
    match /challenges/{cid} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'key', 'fromScore', 'toScore', 'status', 'at', 'doneAt'])
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/accounts/$(request.resource.data.to))
        && request.resource.data.key is string && request.resource.data.key.size() <= 40
        && request.resource.data.fromScore == get(/databases/$(database)/documents/scores/$(request.auth.uid)).data.best[request.resource.data.key].s
        && request.resource.data.toScore == null && request.resource.data.status == 'open'
        && request.resource.data.doneAt == null && request.resource.data.at == request.time;
      allow update: if signedIn() && resource.data.to == request.auth.uid && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toScore', 'status', 'doneAt'])
        && request.resource.data.doneAt == request.time
        && ((request.resource.data.status == 'declined' && request.resource.data.toScore == null)
          || (request.resource.data.status == 'done' && request.resource.data.toScore is number
              && request.resource.data.toScore >= 0 && request.resource.data.toScore <= 1500000));
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // 접속 표시: 본인 것만, 서버 시각만 기록
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    // 실시간 1:1 대결 방 (방 코드로 참가 · 방장/참가자만 자기 점수 칸을 씀)
    match /rooms/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'guest', 'inv', 'key', 'state', 'at', 'go', 'hs', 'gs', 'hd', 'gd'])
        && request.resource.data.state == 'wait' && request.resource.data.guest == null && request.resource.data.go == null
        && request.resource.data.hs == 0 && request.resource.data.gs == 0 && request.resource.data.hd == false && request.resource.data.gd == false
        && request.resource.data.key is string && request.resource.data.key.size() <= 40 && request.resource.data.at == request.time
        && (request.resource.data.inv == null || request.resource.data.inv is string);
      allow update: if signedIn() && (
          (resource.data.host == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inv', 'state', 'go', 'hs', 'hd'])
            && request.resource.data.state in ['wait', 'ready', 'play', 'done']
            && (request.resource.data.go == resource.data.go || request.resource.data.go == request.time)
            && request.resource.data.hs is number && request.resource.data.hs >= 0 && request.resource.data.hs <= 1500000)
        || (resource.data.guest == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gs', 'gd', 'state'])
            && request.resource.data.state in ['ready', 'play', 'done']
            && request.resource.data.gs is number && request.resource.data.gs >= 0 && request.resource.data.gs <= 1500000)
        || (resource.data.guest == null && resource.data.state == 'wait' && resource.data.host != request.auth.uid
            && request.resource.data.guest == request.auth.uid && request.resource.data.state == 'ready'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'state'])));
      allow delete: if signedIn() && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid);
    }
    // 서버 최초 기록 (UNIQUE 칭호): 처음 만든 단 한 명만 · 본인 랭킹 기록에 DEATH 클리어가 있어야 함 · 바꾸거나 지울 수 없음
    match /firsts/{kind} {
      allow read: if true;
      allow create: if signedIn() && kind == 'death' && !isDev()
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'key', 'at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 16
        && request.resource.data.key is string && request.resource.data.key.matches('^[a-z0-9]+#11@1$')
        && get(/databases/$(database)/documents/scores/$(request.auth.uid)).data.best[request.resource.data.key].l >= 3;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
